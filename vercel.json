{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "dist",
  "functions": {
    "api/server.js": {
      "includeFiles": "{pagina.html,css/style.css,admin/**,js/editor.js,js/cms.js,data/content.defaults.json}"
    }
  },
  "rewrites": [
    {
      "source": "/js/editor.js",
      "destination": "/api/server"
    },
    {
      "source": "/admin",
      "destination": "/api/server"
    },
    {
      "source": "/painel",
      "destination": "/api/server"
    },
    {
      "source": "/painel/:rest*",
      "destination": "/api/server"
    },
    {
      "source": "/api/:rest*",
      "destination": "/api/server"
    }
  ]
}
