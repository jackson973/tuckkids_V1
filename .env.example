# ===== obrigatórias em produção (Vercel: Settings → Environment Variables) =====

# Senha do PRIMEIRO admin (login "admin"); usada só no bootstrap.
# Depois, gerencie usuários pelo painel (👥 Usuários).
ADMIN_PASSWORD=troque-esta-senha

# Segredo de sessão/criptografia. OBRIGATÓRIO na Vercel (gere um valor longo
# aleatório, ex.: openssl rand -hex 32). Trocar invalida sessões e o
# arquivo de usuários (o admin é recriado a partir de ADMIN_PASSWORD).
SESSION_SECRET=

# URL do Deploy Hook (Vercel: Settings → Git → Deploy Hooks → Create).
# Com ela, todo "Salvar" no painel dispara um novo build do site público.
DEPLOY_HOOK_URL=

# Domínio público do site (para sitemap/robots), ex.: https://tuckkids.com.br
SITE_URL=

# ===== automáticas =====
# BLOB_READ_WRITE_TOKEN — criada pela Vercel ao conectar um Blob Store ao projeto.
#   Sem ela (dev local), tudo é salvo em data/ no disco.

# Porta (apenas dev/VPS)
PORT=3000
