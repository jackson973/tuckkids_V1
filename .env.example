# Senha do painel (usada só no primeiro boot para criar data/admin.json;
# para trocar depois: apague data/admin.json e reinicie com a nova senha)
ADMIN_PASSWORD=troque-esta-senha

# Segredo dos cookies de sessão (se ausente, é gerado e salvo em data/secret.key)
SESSION_SECRET=

# Porta do servidor
PORT=3000
